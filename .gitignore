# ============================================================
#  samr_project — .gitignore
#  FastAPI (Python) backend + React / Vite frontend
# ============================================================

# ──────────────────────────────
#  SECRETS — never commit these
# ──────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────
#  Python / Backend
# ──────────────────────────────
# Virtual environments
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/

# Compiled Python files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
backend/dist/
backend/build/
backend/*.egg-info/
*.egg

# Type checking
.mypy_cache/
.dmypy.json
.pyright/

# Testing
.pytest_cache/
.coverage
htmlcov/

# SQLite database files
*.db
*.sqlite
*.sqlite3

# ──────────────────────────────
#  Node / Frontend
# ──────────────────────────────
# Dependencies
frontend/node_modules/
node_modules/

# Vite / build output
frontend/dist/
frontend/.vite/
dist/

# Env files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Cache
frontend/.cache/
.eslintcache

# ──────────────────────────────
#  Editors & IDEs
# ──────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
Session.vim

# Emacs
*~
\#*\#

# ──────────────────────────────
#  OS artifacts
# ──────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ──────────────────────────────
#  Logs
# ──────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────
#  Miscellaneous
# ──────────────────────────────
*.bak
*.tmp
*.orig
